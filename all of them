char	*ft_strdup(const char *s)
{
	size_t			len;
	char			*ptr;
	size_t			i;

	i = 0;
	len = ft_strlen(s);
	ptr = malloc(sizeof(unsigned char) * len + 1);
	if (ptr == NULL)
		return (NULL);
	while (s[i] != '\0')
	{
		ptr[i] = s[i];
		i++;
	}
	ptr[i] = '\0';
	return (ptr);
}

