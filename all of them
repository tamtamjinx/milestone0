char	*ft_strmapi(char const *s, char (*f)(unsigned int, char))
{
	unsigned int		i;
	size_t				len_s;
	char				*ptr;

	if (!s || !f)
		return (NULL);
	len_s = ft_strlen(s);
	if (len_s == 0)
		return (ft_strdup(""));
	ptr = malloc(len_s + 1);
	if (!ptr)
		return (NULL);
	i = 0;
	while (s[i])
	{
		ptr[i] = f(i, s[i]);
		i++;
	}
	ptr[i] = '\0';
	return (ptr);
}

