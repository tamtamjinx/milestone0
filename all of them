void	ft_putnbr_fd(int n, int fd)
{
	long	num;

	num = n;
	if (num == 0)
	{
		write (fd, "0", 1);
		return ;
	}
	if (num < 0)
	{
		num *= -1;
		write (fd, "-", 1);
	}
	ft_long_putnbr_fd (num, fd);
}

