#include "libft.h"

static int	in_set(char const c, char const *set)
{
	size_t	i;

	i = 0;
	while (set[i])
	{
		if (c == set[i])
			return (1);
		i++;
	}
	return (0);
}

char	*ft_strtrim(char const *s1, char const *set)
{
	size_t	i;
	long	j;
	char	*ptr;

	if (!s1 || !set)
		return (NULL);
	j = ft_strlen(s1) - 1;
	i = 0;
	while (in_set(s1[i], set) && s1[i])
		i++;
	if (i == ft_strlen(s1))
		return (ft_strdup(""));
	while (in_set(s1[j], set) && j >= 0)
		j--;
	ptr = malloc (j - i + 2);
	if (ptr == NULL)
		return (NULL);
	ptr = (char *)ft_memcpy(ptr, s1 + i, j - i + 1);
	ptr[j - i + 1] = '\0';
	return (ptr);
}
