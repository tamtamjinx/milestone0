void	ft_lstadd_back(t_list **lst, t_list *new)
{
	t_list	*last;

	if (!lst || !new)
		return ;
	last = ft_lstlast(*lst);
	if (!last)
	{
		ft_lstadd_front(lst, new);
		return ;
	}
	last->next = new;
}

