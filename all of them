static long	absu(long n)
{
	if (n > 0)
		return (n);
	return (n * -1);
}

static int	num_len(long num)
{
	int	i;

	i = 1;
	if (num < 0)
	{
		num *= -1;
		i++;
	}
	while (num >= 10)
	{
		num /= 10;
		i++;
	}
	return (i);
}

char	*ft_itoa(int n)
{
	long	num;
	int		sign;
	char	*ptr;
	int		i;

	sign = 0;
	if (n < 0)
		sign = 1;
	num = absu((long) n);
	ptr = malloc(num_len((long) n) + 1);
	if (!ptr)
		return (NULL);
	ptr[num_len(n)] = '\0';
	i = (num_len(n) - 1);
	while (i >= sign)
	{
		ptr[i] = ((num % 10) + '0');
		num /= 10;
		i--;
	}
	if (sign == 1)
		ptr[i] = '-';
	return (ptr);
}
